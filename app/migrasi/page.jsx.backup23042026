"use client";
import { useState, useEffect, useRef } from "react";
import { supabase } from "../../src/lib/supabase";
import { getPegawai } from "../../src/lib/auth";
import * as XLSX from "xlsx";
import { UploadCloud, Download, Database, AlertCircle, CheckCircle2, Loader2, ArrowLeft } from "lucide-react";
import Link from "next/link";

export default function MigrasiData() {
  const [isAdmin, setIsAdmin] = useState(false);
  const [loadingInitial, setLoadingInitial] = useState(true);
  
  // Status UI
  const [file, setFile] = useState(null);
  const [previewData, setPreviewData] = useState([]);
  const [gudangMap, setGudangMap] = useState({});
  const [importStatus, setImportStatus] = useState("idle"); // idle | parsing | ready | importing | success | error
  const [importProgress, setImportProgress] = useState({ current: 0, total: 0 });
  
  const fileInputRef = useRef(null);

  useEffect(() => {
    checkAuthAndLoadContext();
  }, []);

  async function checkAuthAndLoadContext() {
    const user = await getPegawai();
    if (user && String(user.role).toLowerCase().includes("super")) {
      setIsAdmin(true);
      // Load Referensi Gudang (Untuk mencocokkan Nama Gudang di Excel dengan ID Gudang di Database)
      const { data: gudangData } = await supabase.from('gudang').select('id, nama');
      const gMap = {};
      if (gudangData) {
        gudangData.forEach(g => {
          gMap[g.nama.toLowerCase().trim()] = g.id;
        });
      }
      setGudangMap(gMap);
    } else {
      window.location.href = "/";
    }
    setLoadingInitial(false);
  }

  // --- LOGIC EXPORT & TEMPLATE ---
  const downloadTemplate = async () => {
    // Ambil list gudang untuk ditaruh di Sheet ke-2 sebagai Referensi
    const { data: gudangData } = await supabase.from('gudang').select('id, nama, bidang_upt(nama)');
    
    const templateBarang = [{
      KODE_ASET: "PJU.5.2.6.02.001",
      NAMA_BARANG: "Kabel NYY 4x10mm",
      KATEGORI: "Kabel & Jaringan",
      SATUAN: "Meter",
      STOK: 0,
      MIN_STOK: 10,
      HARGA_SATUAN: 45000,
      NAMA_GUDANG: gudangData?.[0]?.nama || "Gudang PJU",
      BIDANG_UPT: "UPT Penerangan Jalan Umum"
    }];

    const referensiGudang = gudangData ? gudangData.map(g => ({
      NAMA_GUDANG: g.nama,
      BIDANG_UPT: g.bidang_upt?.nama || "-"
    })) : [];

    const wb = XLSX.utils.book_new();
    
    // Sheet 1: Template
    const ws1 = XLSX.utils.json_to_sheet(templateBarang);
    ws1['!cols'] = [{ wch: 20 }, { wch: 40 }, { wch: 20 }, { wch: 10 }, { wch: 10 }, { wch: 15 }, { wch: 20 }, { wch: 25 }, { wch: 30 }];
    XLSX.utils.book_append_sheet(wb, ws1, "Form_Import");

    // Sheet 2: Referensi Gudang (agar operator tidak salah ketik)
    const ws2 = XLSX.utils.json_to_sheet(referensiGudang);
    ws2['!cols'] = [{ wch: 30 }, { wch: 30 }];
    XLSX.utils.book_append_sheet(wb, ws2, "Referensi_Gudang (JGN DIHAPUS)");

    XLSX.writeFile(wb, "Template_Import_PINS.xlsx");
  };

  const exportDataBackup = async () => {
    try {
      const { data, error } = await supabase.from('barang').select('*, gudang:gudang_id(nama)');
      if (error) throw error;
      
      const formatted = data.map(d => ({
        KODE_ASET: d.kode_aset,
        NAMA_BARANG: d.nama,
        KATEGORI: d.kategori,
        SATUAN: d.satuan,
        STOK: d.stok,
        MIN_STOK: d.stok_minimum,
        HARGA_SATUAN: d.harga_satuan,
        NAMA_GUDANG: d.gudang?.nama || "-",
        BIDANG_UPT: d.bidang_upt
      }));

      const ws = XLSX.utils.json_to_sheet(formatted);
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, "Backup_Data");
      XLSX.writeFile(wb, `Backup_PINS_${new Date().toISOString().split('T')[0]}.xlsx`);
    } catch (err) {
      alert("Gagal menarik backup: " + err.message);
    }
  };

  // --- LOGIC IMPORT ---
  const handleFileUpload = (e) => {
    const uploadedFile = e.target.files[0];
    if (!uploadedFile) return;
    setFile(uploadedFile);
    setImportStatus("parsing");

    const reader = new FileReader();
    reader.onload = (evt) => {
      try {
        const bstr = evt.target.result;
        const wb = XLSX.read(bstr, { type: 'binary' });
        // Selalu ambil sheet pertama
        const wsname = wb.SheetNames[0];
        const ws = wb.Sheets[wsname];
        const data = XLSX.utils.sheet_to_json(ws);
        
        // Validasi & Transformasi Data
        const parsed = data.map((row, index) => {
          const namaGudang = String(row.NAMA_GUDANG || "").toLowerCase().trim();
          const mappedGudangId = gudangMap[namaGudang] || null;
          
          return {
            _row: index + 2, // +1 untuk header, +1 karena index mulai dari 0
            kode_aset: row.KODE_ASET || "",
            nama: row.NAMA_BARANG,
            kategori: row.KATEGORI || "Tanpa Kategori",
            satuan: row.SATUAN || "Unit",
            stok: parseInt(row.STOK) || 0,
            stok_minimum: parseInt(row.MIN_STOK) || 0,
            harga_satuan: parseInt(row.HARGA_SATUAN) || 0,
            bidang_upt: row.BIDANG_UPT || "",
            // Logika Pintar: Konversi Nama Gudang ke UUID
            gudang_id: mappedGudangId, 
            _rawGudangName: row.NAMA_GUDANG,
            isValid: !!row.NAMA_BARANG && !!mappedGudangId
          };
        });

        setPreviewData(parsed);
        setImportStatus("ready");
      } catch (err) {
        alert("Gagal membaca file Excel. Pastikan formatnya sesuai.");
        setImportStatus("error");
      }
    };
    reader.readAsBinaryString(uploadedFile);
  };

  const executeImport = async () => {
    const validData = previewData.filter(d => d.isValid);
    if (validData.length === 0) return alert("Tidak ada data valid untuk diimport!");

    const isConfirm = window.confirm(`Peringatan: Anda akan memasukkan ${validData.length} data barang ke dalam database. Lanjutkan?`);
    if (!isConfirm) return;

    setImportStatus("importing");
    setImportProgress({ current: 0, total: validData.length });

    // Hapus temporary keys sebelum di-insert
    const payload = validData.map(({ _row, isValid, _rawGudangName, ...rest }) => rest);

    // Proses Batch Insert (Mencegah timeout dengan memotong per 100 baris)
    const BATCH_SIZE = 100;
    let successCount = 0;

    try {
      for (let i = 0; i < payload.length; i += BATCH_SIZE) {
        const batch = payload.slice(i, i + BATCH_SIZE);
        const { error } = await supabase.from('barang').insert(batch);
        if (error) throw error;
        
        successCount += batch.length;
        setImportProgress({ current: successCount, total: validData.length });
      }
      setImportStatus("success");
    } catch (err) {
      alert("Terjadi kegagalan saat proses import: " + err.message);
      setImportStatus("error");
    }
  };

  if (loadingInitial) return <div className="flex justify-center items-center h-screen"><Loader2 className="animate-spin text-amber-500" size={40} /></div>;
  if (!isAdmin) return null;

  const validRows = previewData.filter(d => d.isValid).length;
  const invalidRows = previewData.length - validRows;

  return (
    <div className="max-w-6xl mx-auto space-y-6 pb-20 p-4">
      <div className="flex items-center gap-4 border-b border-slate-800 pb-4">
        <Link href="/" className="p-2 bg-slate-800 rounded-lg text-slate-400 hover:text-white transition-colors">
          <ArrowLeft size={20} />
        </Link>
        <div>
          <h1 className="text-2xl font-black text-white flex items-center gap-2">
            <Database className="text-amber-500" /> Pusat Migrasi Data
          </h1>
          <p className="text-sm text-slate-400">Export & Import massal data inventaris dari file Microsoft Excel (.xlsx)</p>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        {/* PANEL KIRI: PERANGKAT EXPORT */}
        <div className="md:col-span-1 space-y-4">
          <div className="bg-[#1e293b] p-6 rounded-2xl border border-slate-700 shadow-xl">
            <h3 className="font-bold text-white mb-4 flex items-center gap-2">
              <Download size={18} className="text-emerald-500" /> Ambil Template Kosong
            </h3>
            <p className="text-xs text-slate-400 mb-6 leading-relaxed">
              Unduh format Excel standar PINS. Bagikan file ini ke UPT/Bidang untuk diisi dengan data fisik opname terbaru.
            </p>
            <button onClick={downloadTemplate} className="w-full py-3 bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 border border-emerald-500/30 rounded-xl text-sm font-bold transition-all flex justify-center items-center gap-2">
              <Download size={16} /> Unduh Format .XLSX
            </button>
          </div>

          <div className="bg-[#1e293b] p-6 rounded-2xl border border-slate-700 shadow-xl">
            <h3 className="font-bold text-white mb-4 flex items-center gap-2">
              <Database size={18} className="text-blue-500" /> Backup Data Eksisting
            </h3>
            <p className="text-xs text-slate-400 mb-6 leading-relaxed">
              Sangat disarankan untuk mem-backup seluruh data barang yang ada di sistem saat ini sebelum melakukan impor massal yang baru.
            </p>
            <button onClick={exportDataBackup} className="w-full py-3 bg-blue-500/10 text-blue-400 hover:bg-blue-500/20 border border-blue-500/30 rounded-xl text-sm font-bold transition-all flex justify-center items-center gap-2">
              <Download size={16} /> Tarik Backup Database
            </button>
          </div>
        </div>

        {/* PANEL KANAN: SMART IMPORTER */}
        <div className="md:col-span-2 bg-[#1e293b] p-6 rounded-2xl border border-slate-700 shadow-xl flex flex-col">
          <h3 className="font-bold text-white mb-1 flex items-center gap-2">
            <UploadCloud size={18} className="text-amber-500" /> Smart Uploader (Import Data)
          </h3>
          <p className="text-xs text-slate-400 mb-6">Unggah file template Excel yang sudah diisi di sini.</p>

          {importStatus === "idle" || importStatus === "error" ? (
            <div 
              className="flex-1 border-2 border-dashed border-slate-600 hover:border-amber-500 bg-[#0f172a] rounded-xl flex flex-col items-center justify-center p-10 transition-colors cursor-pointer group"
              onClick={() => fileInputRef.current?.click()}
            >
              <div className="w-16 h-16 bg-slate-800 rounded-full flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <UploadCloud size={32} className="text-slate-400 group-hover:text-amber-500" />
              </div>
              <p className="font-bold text-white text-center">Klik atau Drag & Drop File Excel Anda</p>
              <p className="text-xs text-slate-500 mt-2">Format yang didukung: .xlsx, .xls</p>
              <input type="file" accept=".xlsx, .xls" className="hidden" ref={fileInputRef} onChange={handleFileUpload} />
            </div>
          ) : null}

          {importStatus === "parsing" && (
            <div className="flex-1 flex flex-col items-center justify-center py-20">
              <Loader2 size={40} className="text-amber-500 animate-spin mb-4" />
              <p className="text-slate-300 font-bold">Membaca dan Memvalidasi Data Excel...</p>
            </div>
          )}

          {importStatus === "ready" && (
            <div className="flex flex-col flex-1 animate-in fade-in">
              <div className="flex items-center gap-3 bg-slate-800 p-4 rounded-xl border border-slate-700 mb-4">
                <CheckCircle2 size={24} className="text-emerald-500 flex-shrink-0" />
                <div>
                  <p className="font-bold text-white">File Berhasil Dibaca: {file?.name}</p>
                  <p className="text-xs text-slate-400">Total {previewData.length} baris data ditemukan.</p>
                </div>
                <button onClick={() => setImportStatus("idle")} className="ml-auto text-xs text-slate-400 hover:text-white underline">Ganti File</button>
              </div>

              <div className="grid grid-cols-2 gap-4 mb-6">
                <div className="bg-emerald-500/10 p-3 rounded-xl border border-emerald-500/20 text-center">
                  <p className="text-2xl font-black text-emerald-400">{validRows}</p>
                  <p className="text-[10px] uppercase font-bold text-slate-400">Baris Valid</p>
                </div>
                <div className="bg-red-500/10 p-3 rounded-xl border border-red-500/20 text-center">
                  <p className="text-2xl font-black text-red-400">{invalidRows}</p>
                  <p className="text-[10px] uppercase font-bold text-slate-400">Gagal Validasi</p>
                </div>
              </div>

              {invalidRows > 0 && (
                <div className="bg-red-500/10 p-4 rounded-xl border border-red-500/30 mb-6">
                  <p className="text-sm font-bold text-red-400 flex items-center gap-2 mb-2"><AlertCircle size={16} /> Alasan Gagal Validasi:</p>
                  <ul className="text-xs text-slate-300 list-disc pl-5 space-y-1">
                    <li>Nama Barang kosong, ATAU</li>
                    <li>Nama Gudang salah ketik (tidak cocok dengan database PINS).</li>
                  </ul>
                  <p className="text-xs text-red-400/80 mt-2 italic">Hanya {validRows} baris valid yang akan dimasukkan ke database.</p>
                </div>
              )}

              <button onClick={executeImport} disabled={validRows === 0} className="w-full py-4 mt-auto bg-amber-500 hover:bg-amber-400 text-slate-900 rounded-xl font-black transition-all disabled:opacity-50 flex justify-center items-center gap-2 shadow-lg shadow-amber-900/20">
                <Database size={20} /> Eksekusi Import Data
              </button>
            </div>
          )}

          {importStatus === "importing" && (
            <div className="flex-1 flex flex-col items-center justify-center py-20 animate-in fade-in">
              <Loader2 size={48} className="text-emerald-500 animate-spin mb-6" />
              <p className="text-xl font-bold text-white mb-2">Mengirim ke Database...</p>
              <div className="w-full max-w-xs bg-slate-800 rounded-full h-3 mb-2 overflow-hidden border border-slate-700">
                <div className="bg-emerald-500 h-3 rounded-full transition-all duration-300" style={{ width: `${(importProgress.current / importProgress.total) * 100}%` }}></div>
              </div>
              <p className="text-xs text-slate-400 font-mono">{importProgress.current} / {importProgress.total} Data Tersimpan</p>
            </div>
          )}

          {importStatus === "success" && (
            <div className="flex-1 flex flex-col items-center justify-center py-16 animate-in zoom-in">
              <div className="w-20 h-20 bg-emerald-500/20 rounded-full flex items-center justify-center mb-6">
                <CheckCircle2 size={48} className="text-emerald-500" />
              </div>
              <h2 className="text-2xl font-black text-white mb-2">Import Selesai!</h2>
              <p className="text-slate-400 text-center mb-8">Sebanyak {importProgress.total} aset berhasil ditambahkan ke dalam database PINS.</p>
              <div className="flex gap-4">
                <button onClick={() => setImportStatus("idle")} className="px-6 py-2.5 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-sm font-bold transition-all border border-slate-600">Import File Lain</button>
                <Link href="/barang" className="px-6 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-900 rounded-xl text-sm font-black transition-all shadow-lg shadow-emerald-900/20">Lihat Data Barang</Link>
              </div>
            </div>
          )}

        </div>
      </div>
    </div>
  );
}
