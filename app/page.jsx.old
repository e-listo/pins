function QRCodeSVG({ value, size = 140 }) {
  const hash = s => s.split("").reduce((a, c) => ((a << 5) - a + c.charCodeAt(0)) | 0, 0);
  const seed = Math.abs(hash(value)); const grid = 21; const cs = size / grid;
  const cells = [];
  for (let r = 0; r < grid; r++) for (let c = 0; c < grid; c++) {
    const isFinder = (r < 8 && c < 8) || (r < 8 && c >= grid - 8) || (r >= grid - 8 && c < 8);
    const on = isFinder ? (r === 0 || r === 7 || c === 0 || c === 7 || (r >= 2 && r <= 4 && c >= 2 && c <= 4) || (r >= 2 && r <= 4 && c >= grid - 6 && c <= grid - 3) || (r >= grid - 6 && r <= grid - 3 && c >= 2 && c <= 4)) : (((seed * (r * grid + c + 1)) & 0x3f) > 20);
    cells.push({ r, c, on });
  }
  return <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`}><rect width={size} height={size} fill="white" />{cells.map(({ r, c, on }) => on ? <rect key={`${r}-${c}`} x={c * cs} y={r * cs} width={cs} height={cs} fill="#111827" /> : null)}</svg>;
}

function Sparkline({ data, color = "#3b82f6", h = 30, w = 70 }) {
  const max = Math.max(...data), min = Math.min(...data);
  const pts = data.map((v, i) => `${(i / (data.length - 1)) * w},${h - ((v - min) / (max - min + 1)) * h}`);
  return <svg width={w} height={h} viewBox={`0 0 ${w} ${h}`}><path d={`M${pts.join("L")}V${h}H0Z`} fill={color + "20"} /><path d={`M${pts.join("L")}`} fill="none" stroke={color} strokeWidth="1.8" strokeLinecap="round" /></svg>;
}

function Badge({ label, type }) {
  const m = { masuk: "bg-emerald-100 text-emerald-700", keluar: "bg-red-100 text-red-700", mutasi: "bg-amber-100 text-amber-700", alert: "bg-red-100 text-red-600", ok: "bg-emerald-100 text-emerald-700" };
  return <span className={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${m[type] || "bg-slate-100 text-slate-600"}`}>{label}</span>;
}

function Modal({ title, onClose, width = "max-w-lg", children }) {
  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4" style={{ background: "rgba(15,23,42,0.55)", backdropFilter: "blur(4px)" }}>
      <div className={`bg-white rounded-2xl shadow-2xl w-full ${width} max-h-[90vh] overflow-y-auto`} style={{ animation: "modalIn .18s ease" }}>
        <div className="flex items-center justify-between p-5 border-b border-slate-100">
          <h3 className="text-sm font-bold text-slate-800">{title}</h3>
          <button onClick={onClose} className="p-1.5 rounded-lg hover:bg-slate-100 text-slate-400 transition-colors"><Icon d={Icons.close} size={16} /></button>
        </div>
        <div className="p-5">{children}</div>
      </div>
    </div>
  );
}

const inputCls = "w-full border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 bg-slate-50 hover:bg-white transition-colors";
function Field({ label, children }) {
  return <div className="mb-3"><label className="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">{label}</label>{children}</div>;
}

